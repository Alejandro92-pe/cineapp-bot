# Documentation only. run_local.py does NOT load this file or production secrets.
APP_MODE=production
APP_ORIGIN=https://your-app.example
# Direct/pooler PostgreSQL connection for the private security schema (TLS required).
# Apply the reviewed SQL manually before deployment; the application runs no production DDL.
SECURITY_DATABASE_URL=postgresql+psycopg://ROLE:PASSWORD@HOST:5432/postgres?sslmode=require
# Owner is fixed in code: 5824989040. ADMIN_ID cannot grant access to another admin.
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD is accepted only if its value is an existing bcrypt hash ($2a/$2b/$2y).
CRON_SECRET=
TELEGRAM_WEBHOOK_SECRET=
BMC_WEBHOOK_SECRET=
# Monthly one-off shop item. Enable only after confirming US$1.50 and adding
# a required product question "Código de compra" in BMC. Never a membership.
BMC_MONTHLY_PRODUCT_ID=517243
BMC_MONTHLY_READY=false
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
BOT_TOKEN=
TMDB_API_KEY=
VIMEUS_VIEW_KEY=
# Private Listing API credential, distinct from the iframe view key.
VIMEUS_API_KEY=
# Enable after migrations 001-014 and authenticated cron are verified.
# The existing /cron/verificar_vencimientos runs one resumable batch per request.
CATALOG_IMPORT_ENABLED=false
